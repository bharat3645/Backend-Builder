# Development image for the InfraNest frontend (Vite dev server with HMR).
# Not intended for production - see the "Docker" section of README.md for
# building a static production image instead.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
