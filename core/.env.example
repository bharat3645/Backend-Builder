# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# CORS - comma-separated list of allowed origins (or * for any)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (used by generated projects / future persistence layer)
DATABASE_URL=postgresql://infranest:infranest@localhost:5432/infranest

# Redis (job queue / caching)
REDIS_URL=redis://localhost:6379/0

# AI providers for natural-language -> DSL generation (optional).
# If neither is set, the API falls back to a deterministic keyword-based
# DSL generator so the platform still works without any AI provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
